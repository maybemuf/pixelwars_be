{
	order rate_limit before basic_auth
}

{$SITE_ADDRESS:http://localhost} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	# Swagger UI pulls its bundle and stylesheet from cdn.jsdelivr.net, which the
	# default-src 'none' policy above blocks -- /docs rendered blank behind the proxy.
	# Narrowest exception that makes the docs usable; every other path keeps 'none'.
	@docs path /docs /docs/* /redoc /redoc/* /openapi.json
	header @docs Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; frame-ancestors 'none'"

	rate_limit {
		zone dynamic_zone {
			key {http.request.remote_ip}
			events 30
			window 15s
		}
	}

	reverse_proxy api:8000
}
