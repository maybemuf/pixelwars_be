# Copy to .env and fill in. Everything without a comment already works as-is locally.

# "dev" or "prod". Anything but "prod" keeps console telemetry exporters on and
# leaves logs human-readable instead of JSON.
ENVIRONMENT="dev"

# Reported in OpenAPI, the startup log line, and OTel's service.version.
API_VERSION="0.0.1"

# From console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Add http://localhost:8000/auth/google/callback as an
# authorized redirect URI. Leave both blank to run the board read-only: watching is
# anonymous, only painting needs a login.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Signs the short-lived OAuth state cookie. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=""

# "redis" is the compose service name; use localhost only if you run Redis yourself.
REDIS_HOST="redis"
REDIS_PORT=6379

# Where the OAuth callback sends the browser back to, and the sole allowed CORS origin.
FRONTEND_URL="http://localhost:3000"

# Seconds a user must wait between pixels.
COOLDOWN_SEC=60

# Optional; defaults to 14 days. Sliding: every request refreshes it.
#SESSION_TTL=1209600

# The address Caddy serves on. A bare hostname makes Caddy provision a real
# certificate, so keep the http:// scheme for local use.
SITE_ADDRESS="http://localhost"

OTEL_ENABLED=false
# "otel-lgtm" is the bundled Grafana stack; its UI is on http://localhost:3010.
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-lgtm:4318"
# Trace sample rate, 0..1.
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
# Probes run every few seconds; tracing them buries everything else.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS="health/live,health/ready"
